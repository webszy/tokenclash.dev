---
import { siteConfig } from "../config/site";
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="#top" aria-label="TokenClash home">
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M5 9h8l3 7 3-7h8M5 23h8l3-7 3 7h8" />
        <circle cx="5" cy="9" r="2" />
        <circle cx="27" cy="9" r="2" />
        <circle cx="5" cy="23" r="2" />
        <circle cx="27" cy="23" r="2" />
      </svg>
      <span>{siteConfig.name}</span>
    </a>

    <nav class="header-nav" aria-label="Primary navigation">
      <a href="#features">Features</a>
      <a href="#developer-experience">Quick start</a>
      <a href="#roadmap">Roadmap</a>
    </nav>

    <div class="header-actions">
      {
        siteConfig.githubUrl ? (
          <a class="github-link" href={siteConfig.githubUrl} target="_blank" rel="noreferrer">
            GitHub
          </a>
        ) : (
          <span class="github-link is-disabled" aria-disabled="true" title="Repository coming soon">
            GitHub
          </span>
        )
      }
      <button class="theme-toggle" type="button" aria-label="Switch to light theme" title="Toggle theme">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="3.5" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" />
        </svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 15.2A8.5 8.5 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");

  const syncToggle = () => {
    const isLight = document.documentElement.dataset.theme === "light";
    toggle?.setAttribute("aria-label", isLight ? "Switch to dark theme" : "Switch to light theme");
  };

  syncToggle();
  toggle?.addEventListener("click", () => {
    const nextTheme = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = nextTheme;
    localStorage.setItem("tokenclash-theme", nextTheme);
    syncToggle();
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 82%, transparent);
    background: color-mix(in srgb, var(--canvas) 86%, transparent);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    display: flex;
    min-height: 4.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-code);
    font-size: 0.92rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .brand-mark {
    width: 1.75rem;
    height: 1.75rem;
    overflow: visible;
    fill: var(--canvas);
    stroke: var(--route);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .header-nav {
    display: none;
    align-items: center;
    gap: 1.5rem;
    color: var(--muted);
    font-family: var(--font-code);
    font-size: 0.76rem;
  }

  .header-nav a,
  .github-link {
    transition: color 150ms ease;
  }

  .header-nav a:hover,
  .github-link:hover {
    color: var(--route);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .github-link {
    display: none;
    color: var(--muted);
    font-family: var(--font-code);
    font-size: 0.76rem;
  }

  .github-link.is-disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .theme-toggle {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .theme-toggle svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .theme-toggle .sun,
  :global(:root[data-theme="light"]) .theme-toggle .moon {
    display: none;
  }

  :global(:root[data-theme="light"]) .theme-toggle .sun {
    display: block;
  }

  @media (min-width: 40rem) {
    .github-link {
      display: inline-flex;
    }
  }

  @media (min-width: 52rem) {
    .header-nav {
      display: flex;
    }
  }
</style>
