---
const releases = [
  {
    version: "v0.1",
    status: "FOUNDATION",
    items: ["Local gateway", "Provider routing", "OpenAI compatible API"],
    active: true,
  },
  {
    version: "v0.2",
    status: "CONTROL",
    items: ["Usage statistics", "Model rules", "Provider management"],
  },
  {
    version: "v1.0",
    status: "ECOSYSTEM",
    items: ["Cloud sync", "Provider marketplace", "Advanced routing"],
  },
];
---

<section class="section section-rule" id="roadmap" aria-labelledby="roadmap-title">
  <div class="shell">
    <p class="eyebrow">Route ahead</p>
    <h2 class="section-heading" id="roadmap-title">Built locally. Expanded deliberately.</h2>

    <ol class="timeline">
      {
        releases.map((release) => (
          <li class:list={{ active: release.active }}>
            <div class="timeline-marker"><span></span></div>
            <div class="release-heading">
              <strong>{release.version}</strong>
              <small>{release.status}</small>
            </div>
            <ul>
              {release.items.map((item) => <li>{item}</li>)}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    display: grid;
    margin: 3.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .timeline > li {
    position: relative;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.5rem 1rem;
    padding-bottom: 3rem;
  }

  .timeline > li:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    position: relative;
    grid-row: 1 / 3;
    display: flex;
    justify-content: center;
  }

  .timeline-marker::after {
    position: absolute;
    z-index: 0;
    top: 0.75rem;
    bottom: -3rem;
    left: 50%;
    width: 1px;
    background: var(--line);
    content: "";
  }

  .timeline > li:last-child .timeline-marker::after {
    display: none;
  }

  .timeline-marker span {
    position: relative;
    z-index: 1;
    width: 0.7rem;
    height: 0.7rem;
    margin-top: 0.25rem;
    border: 2px solid var(--line-strong);
    border-radius: 50%;
    background: var(--canvas);
  }

  .timeline > li.active .timeline-marker span {
    border-color: var(--route);
    background: var(--route);
    box-shadow: 0 0 0 0.3rem var(--route-soft), 0 0 1rem var(--route);
  }

  .release-heading {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .release-heading strong {
    font-family: var(--font-code);
    font-size: 1.3rem;
  }

  .release-heading small {
    color: var(--muted);
    font-family: var(--font-code);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
  }

  .timeline ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  .timeline ul li {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    padding: 0.45rem 0.7rem;
    font-family: var(--font-code);
    font-size: 0.68rem;
  }

  .timeline > li.active .release-heading strong,
  .timeline > li.active ul li {
    color: var(--ink);
  }

  @media (min-width: 48rem) {
    .timeline {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .timeline > li {
      grid-template-columns: 1fr;
      padding: 0 2rem 0 0;
    }

    .timeline-marker {
      grid-row: auto;
      justify-content: flex-start;
      height: 2rem;
    }

    .timeline-marker::after {
      top: 0.58rem;
      right: 0;
      bottom: auto;
      left: 0.7rem;
      width: auto;
      height: 1px;
    }
  }
</style>
